{
  "name": "rallypoint",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.worker.json",
    "check": "npm run lint && npm run build",
    "db:start": "node scripts/local.mjs start",
    "db:reset": "node scripts/local.mjs reset",
    "db:stop": "node scripts/local.mjs stop",
    "db:lint": "supabase db lint --local",
    "test:api": "node --test --test-concurrency=1 tests/*.test.mjs"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@phosphor-icons/react": "2.1.10",
    "@supabase/supabase-js": "2.118.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261021.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "supabase": "2.121.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "wrangler": "4.151.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
