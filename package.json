{
  "name": "rallypoint",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.14.0 <12"
  },
  "scripts": {
    "postinstall": "pnpm db:generate",
    "dev": "pnpm db:generate && turbo run dev --cache-dir=.turbo/cache",
    "build": "pnpm db:generate && turbo run build --cache-dir=.turbo/cache",
    "build:cloudflare": "pnpm --filter @rallypoint/database generate:cloudflare && turbo run build:cloudflare --cache-dir=.turbo/cache",
    "db:generate": "pnpm --filter @rallypoint/database generate",
    "db:validate": "pnpm --filter @rallypoint/database validate",
    "start": "pnpm db:generate && pnpm --filter @rallypoint/web start",
    "preview": "pnpm --filter @rallypoint/database generate:cloudflare && pnpm --filter @rallypoint/web preview",
    "lint": "turbo run lint --cache-dir=.turbo/cache",
    "typecheck": "turbo run typecheck --cache-dir=.turbo/cache",
    "check": "pnpm lint && pnpm typecheck && pnpm build",
    "test": "pnpm test:api",
    "test:api": "pnpm db:generate && node --test --test-concurrency=1 tests/*.test.mjs",
    "db:start": "node scripts/local.mjs start",
    "db:reset": "node scripts/local.mjs reset",
    "db:stop": "node scripts/local.mjs stop",
    "db:lint": "supabase db lint --local",
    "build:staging": "node scripts/build-staging.mjs",
    "deploy:staging": "pnpm build:staging && pnpm --filter @rallypoint/web exec wrangler deploy --config wrangler.staging.jsonc --upload-source-maps=false",
    "db:migrate:local": "pnpm db:generate && pnpm --filter @rallypoint/database migrate local",
    "db:migrate:production": "pnpm db:generate && pnpm --filter @rallypoint/database migrate production"
  },
  "devDependencies": {
    "@rallypoint/domain": "workspace:*",
    "@supabase/supabase-js": "2.118.0",
    "@types/node": "24.19.2",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "supabase": "2.121.0",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
