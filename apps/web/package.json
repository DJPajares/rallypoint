{
  "name": "@rallypoint/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "pnpm --filter @rallypoint/database generate && next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "preview": "opennextjs-cloudflare preview --port 3000 --ip 127.0.0.1",
    "lint": "oxlint app src worker.ts",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.13",
    "@phosphor-icons/react": "2.1.10",
    "@rallypoint/api": "workspace:*",
    "@rallypoint/domain": "workspace:*",
    "@rallypoint/email": "workspace:*",
    "@rallypoint/ui": "workspace:*",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "wrangler": "4.151.3"
  }
}
