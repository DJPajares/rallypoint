# Server-only: never put the secret key in NEXT_PUBLIC_* variables or source.
DATABASE_URL=postgresql://replace-with-server-only-database-connection
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SECRET_KEY=replace-with-local-secret-key
LOCAL_AUTH_ENABLED=true
GOOGLE_AUTH_ENABLED=false
EMAIL_DELIVERY_ENABLED=false
EMAIL_PROVIDER=mailpit
MAILPIT_URL=http://127.0.0.1:54324
APP_ORIGIN=http://127.0.0.1:3000
