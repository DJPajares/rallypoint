# Copy to .env.production (gitignored) and fill in once; then run
# `pnpm db:migrate:prod`. Only this name is read from the file.
#
# The RallyPoint production migration connection: Supabase dashboard ->
# wProject -> Connect -> Connection String -> Method "Session pooler" -> URI,
# with the database password in place of [YOUR-PASSWORD] (URL-encode symbols,
# e.g. @ as %40). The runner refuses any other host, port or user.
RALLYPOINT_MIGRATION_DATABASE_URL=postgresql://postgres.zqidfkofbzusvpikftdf:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres
